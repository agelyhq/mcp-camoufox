# Copy to .env and edit. Every variable is optional; see docs/configuration.md.

# Window mode: true (headless) / virtual (Xvfb, Linux only) / false (visible).
# Unset means a visible window, which needs a working desktop GL stack.
CAMOUFOX_HEADLESS=virtual

# Proxy for every session, e.g. http://user:pass@host:port. Turns on GeoIP.
CAMOUFOX_PROXY=

# Where profiles and logs live. Defaults to the OS user data directory.
CAMOUFOX_DATA_DIR=

# Browser window size, e.g. 1000x700. Smaller means cheaper screenshots.
CAMOUFOX_VIEWPORT=

# Default fingerprint OS: windows / linux / macos. Random when unset.
CAMOUFOX_FINGERPRINT_OS=

# Default browser locale, e.g. en-US.
CAMOUFOX_LOCALE=

# Comma-separated addon URLs, overriding the built-in defaults.
CAMOUFOX_ADDON_URLS=

# Explicit path to a Camoufox executable.
CAMOUFOX_BINARY=

# Set false to skip the startup browser and GeoIP update check.
CAMOUFOX_AUTO_UPDATE=

# Humanised cursor, in seconds (e.g. 1.5). Off by default, see docs/decisions.md.
CAMOUFOX_HUMANIZE=

# Share one browser process across conversations. Off by default.
CAMOUFOX_DAEMON=
CAMOUFOX_DAEMON_TTL=
