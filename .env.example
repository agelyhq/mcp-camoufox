# Copy to .env and edit. Every variable is optional and a blank value means "use the
# default", except the 2 flagged below (CAMOUFOX_ADDON_URLS, CAMOUFOX_BROWSER_VERSION)
# where blank is itself a choice. See docs/configuration.md.

# Window mode: true (headless) / virtual (Xvfb, Linux only) / false (visible).
# Unset means a visible window, which needs a working desktop GL stack.
CAMOUFOX_HEADLESS=virtual

# Proxy for every session, e.g. http://user:pass@host:port. Turns on GeoIP. Percent-encode
# the credentials: a password holding @ : or % must be written %40 %3A %25.
CAMOUFOX_PROXY=

# Where profiles and logs live. Defaults to the OS user data directory.
CAMOUFOX_DATA_DIR=

# Browser window size, e.g. 1000x700. Smaller means cheaper screenshots.
CAMOUFOX_VIEWPORT=

# Default fingerprint OS: windows / linux / macos. Random when unset.
CAMOUFOX_FINGERPRINT_OS=

# Default browser locale, e.g. en-US.
CAMOUFOX_LOCALE=

# Comma-separated addon URLs, overriding this project's built-in defaults. Blank is an
# override with nothing, so it loads none of ours, NOT the defaults. Camoufox loads uBlock
# Origin into every browser it launches on its own; no value here removes it.
CAMOUFOX_ADDON_URLS=

# Set false to launch without the addons Camoufox bundles itself (uBlock Origin).
CAMOUFOX_BUNDLED_ADDONS=

# Explicit path to a Camoufox executable. It wins over the pin below, and a path that does
# not exist is refused at startup rather than launched.
CAMOUFOX_BINARY=

# Pins the browser build, e.g. 152.0.4-beta.28. Unset means the build this release was
# tested against. Commented out on purpose: unlike every other variable here, this one is
# NOT optional-when-blank. An empty value (or `latest`) opts out of the pin and follows
# whatever upstream published last, which is how an install changes Firefox major version
# with no change on your side.
#CAMOUFOX_BROWSER_VERSION=

# Set false to skip the startup browser and GeoIP update check.
CAMOUFOX_AUTO_UPDATE=

# Humanised cursor, in seconds (e.g. 1.5). Off by default, see docs/decisions.md.
CAMOUFOX_HUMANIZE=

# Share one browser process across conversations. Off by default.
CAMOUFOX_DAEMON=
CAMOUFOX_DAEMON_TTL=
